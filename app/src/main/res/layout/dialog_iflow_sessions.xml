<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_sessions_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#161B22">

    <LinearLayout
        android:id="@+id/dialog_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="iFlow 会话管理"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E6EDF3" />

            <TextView
                android:id="@+id/badge_sessions_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 个会话"
                android:textSize="10sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/btn_dialog_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="✕"
                android:textSize="14sp"
                android:textColor="#8B949E"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#30363D"
            android:layout_marginBottom="10dp" />

        <!-- Quick Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btn_new_session"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 新建会话"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btn_resume_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="▶ 继续最近"
                android:textSize="11.5sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_refresh_sessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 刷新"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Session List ScrollView -->
        <ScrollView
            android:id="@+id/scroll_sessions"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <LinearLayout
                android:id="@+id/layout_sessions_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Empty State Container -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="暂无历史会话记录"
                        android:textSize="13.5sp"
                        android:textColor="#8B949E"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="点击上方“+ 新建会话”或在终端运行 iflow 即可开始"
                        android:textSize="11.5sp"
                        android:textColor="#484F58" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</LinearLayout>
