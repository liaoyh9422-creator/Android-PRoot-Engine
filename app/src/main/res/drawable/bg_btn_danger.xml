<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#4E1D21" />
            <stroke android:width="1dp" android:color="#F85149" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#2C1517" />
            <stroke android:width="1dp" android:color="#DA3633" />
        </shape>
    </item>
</selector>
